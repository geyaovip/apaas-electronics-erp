# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS build
WORKDIR /workspace
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/electronics-erp/backend/package.json apps/electronics-erp/backend/package.json
COPY apps/electronics-erp/frontend/package.json apps/electronics-erp/frontend/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile --prefer-offline
COPY . .
RUN pnpm --dir apps/electronics-erp/backend build
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
ENV NODE_ENV=production
COPY --from=build /workspace/node_modules /workspace/node_modules
COPY --from=build /workspace/apps/electronics-erp/backend /workspace/apps/electronics-erp/backend
COPY deploy/start-api.sh /workspace/deploy/start-api.sh
COPY LICENSE NOTICE /workspace/
RUN chmod +x /workspace/deploy/start-api.sh
USER node
ENTRYPOINT ["/workspace/deploy/start-api.sh"]
